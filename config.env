# Config File for openHAB Application

# Port Configuration openHab
OPENHAB_HTTP_PORT=8080
OPENHAB_HTTPS_PORT=8443
OPENHAB_CONSOLE_PORT=8101

# InfluxDB Configuration
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin
INFLUXDB_USER=openhab
INFLUXDB_USER_PASSWORD=openhab
INFLUXDB_READ_USER=openhab_ro
INFLUXDB_READ_USER_PASSWORD=openhab_ro
INFLUXDB_OPENHAB_DB=openhab_db

# Port Configuration InfluxDB
INFLUXDB_DB_PORT=8086

# Timezone
TZ=$(timedatectl show --property=Timezone --value)

# WSN Configuration
WSN_HOSTNAME="wsn.local"

# Edge Agent MQTT Configuration (optional)
# If you fill these in, deploy_edge_features.sh will reuse them and ask fewer questions.
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TLS=false
#MQTT_USERNAME=""
#MQTT_PASSWORD=""
#MQTT_CA="/etc/ssl/certs/ca-certificates.crt"
#MQTT_CERT=""
#MQTT_KEY=""
#MQTT_CA_CERTS=/run/secrets/mqtt_ca
#MQTT_CERTFILE=/run/secrets/mqtt_client_crt
#MQTT_KEYFILE=/run/secrets/mqtt_client_key

# Exporter Configuration
# SITE_ID will be filled automatically during deployment; leave blank before first run.
SITE_ID=""
# How often the exporter posts measurements (in seconds, default: 300 = 5 minutes)
EXPORTER_INTERVAL_SECONDS=300

# OpenHAB connection URL - for local docker: http://openhab:8080, for remote: http://remote-host:8080
OH_BASE_URL="http://openhab:8080"
# Token is preferred; if empty, it uses USERNAME/PASSWORD below
OH_TOKEN=""
OPENHAB_USERNAME=""
OPENHAB_PASSWORD=""
OPENHAB_HTTP_TIMEOUT_SECONDS=10
OPENHAB_PERSISTENCE_SERVICE="influxdb"

# How often the exporter posts measurements (in seconds, default: 300 = 5 minutes)
EXPORTER_INTERVAL_SECONDS=300
